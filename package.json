{
  "name": "hermes-workbench",
  "version": "0.8.2",
  "private": false,
  "description": "Minecraft-inspired workspace for Hermes Agent Dashboard",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:python": "env -u CODEX_APP_SERVER_ENDPOINT -u CODEX_HOME uv run --no-project --with-requirements requirements-dev.txt pytest -q tests",
    "release:verify": "bash scripts/verify-release.sh",
    "version:check": "python3 scripts/version.py --check",
    "version:set": "python3 scripts/version.py",
    "release:package": "python3 scripts/package-release.py",
    "privacy:check": "python3 scripts/check-public-content.py",
    "history:check": "python3 scripts/check-history.py"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/view": "^6.43.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "mermaid": "^11.17.2",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xbugs221/hermes-workbench.git"
  },
  "homepage": "https://github.com/xbugs221/hermes-workbench",
  "bugs": {
    "url": "https://github.com/xbugs221/hermes-workbench/issues"
  }
}
